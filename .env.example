# ──────────────────────────────────────────────────────
# xfund Deal Diligence Pipeline — Environment Variables
# ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────

# ── Local Development Flag ──
# Set to "true" to read secrets from env instead of GCP Secret Manager,
# and to use LocalTasksEnqueuer (direct HTTP) instead of Cloud Tasks.
LOCAL_DEV=true

# ── Database (PostgreSQL) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=diligence
DATABASE_USER=diligence
DATABASE_PASSWORD=localdev

# ── Google Cloud Platform (prod only — leave blank for local dev) ──
PROJECT_ID=
REGION=us-central1
WORKER_URL=http://localhost:8082
TASKS_INVOKER_SA_EMAIL=

# ── Perplexity (Phase 1: Web Search) ──
# Used by domain agents for web-grounded research
# Get your key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic (Phase 2: Structured Analysis, Verification, Synthesis, Review) ──
# Default provider for all non-search LLM calls
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI (Alternative to Anthropic — optional) ──
# Only needed if you set SYNTHESIS_LLM_PROVIDER=openai
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Synthesis LLM Configuration ──
# Provider: "anthropic" (default) or "openai"
SYNTHESIS_LLM_PROVIDER=anthropic

# Model override (optional — defaults to claude-sonnet-4-20250514 for anthropic, gpt-4o for openai)
# SYNTHESIS_LLM_MODEL=claude-sonnet-4-20250514

# ── Agent Strategy ──
# Controls how Phase 2 (structured analysis) operates per domain agent:
#   "multi-turn-reflection" (default) — Generate → Critique → Revise cycle (3-5 LLM calls, highest quality)
#   "two-turn"                        — Generate → Self-critique+Revise (2 LLM calls, faster/cheaper)
AGENT_STRATEGY=multi-turn-reflection

# ── Notion ──
# Integration token: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The parent page ID where deal workspaces are created
NOTION_PARENT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Calendar ──
# OAuth2 credentials for calendar sync
# Run: npx tsx scripts/get-gcal-token.ts to generate tokens
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REFRESH_TOKEN=
GCAL_CALENDAR_ID=

# ── Asana ──
# Personal access token: https://app.asana.com/0/developer-console
ASANA_TOKEN=
# The Asana project GID for the deal pipeline board
ASANA_PROJECT_GID=
